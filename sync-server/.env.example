# Copy to .env and fill in. Never commit .env.

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tongyun
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=tongyun_sync

# Auth — personal mode: one API key maps to one user
# Generate a long random string, e.g. openssl rand -hex 32
API_KEY=replace-with-a-long-random-secret
USER_ID=default

# Optional: multiple keys → users (comma-separated key:userId)
# API_KEY_MAP=keyA:alice,keyB:bob

# Server
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
